                    </button>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Inventory Alerts Section -->
      <section v-if="alertItems.length > 0" class="space-y-5 rounded-3xl border border-amber-200 bg-amber-50 p-5 shadow-sm">
