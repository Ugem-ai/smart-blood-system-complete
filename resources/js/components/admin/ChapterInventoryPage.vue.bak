                <td class="px-4 py-3 text-gray-700">{{ adj.reason || '—' }}</td>
                <td class="px-4 py-3 text-gray-600">{{ formatDateTime(adj.date) }}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </a-spin>
  </div>
</template>
            <p class="mt-1 text-xs text-gray-500">Detailed stock, transfers, nearby availability, and API keys appear here.</p>
          </div>

          <template v-else>
